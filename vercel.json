{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/gemini",
      "destination": "/api/gemini.ts"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    }
  ]
}
